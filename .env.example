# =============================================================================
# Job Tracker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# free_run.py uses deterministic rules: no Gemini or DeepSeek key is needed.
# The model settings below are only for optional agent.py runs.
# =============================================================================

# --- AI Provider (choose one) ---

# Option 1: Google Gemini (free tier, subject to your account's limits)
# Get your key at: https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash

# Option 2: DeepSeek (paused; re-enable only after adding API balance)
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_EVALUATION_MODEL=deepseek-chat

# Optional cost/latency controls (defaults shown)
# MAX_MODEL_CALLS=14
# MAX_LLM_EVALUATIONS=6
# MAX_TOOL_CALLS=48
# MAX_SEARCHES=12
# MAX_RESULTS_PER_SEARCH=12
# MAX_INVESTIGATION_DEPTH=2
# AGENT_TIMEOUT_SECONDS=300
# CONTEXT_PRUNE_TOKENS=10000
# AGENT_MAX_OUTPUT_TOKENS=700
# EVALUATION_MAX_OUTPUT_TOKENS=320

# --- Notifications ---

# Telegram Bot (for job notifications)
# 1. Create a bot with @BotFather on Telegram → get the token
# 2. Message @userinfobot to get your chat ID
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
